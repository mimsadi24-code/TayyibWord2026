void _setFontName(String value) {
  final name = value.trim();
  if (name.isEmpty) return;

  setState(() {
    _fontName = name;
    _fontNameController.text = name;
    _fontNameController.selection = TextSelection.collapsed(
      offset: _fontNameController.text.length,
    );
  });
}

void _setFontSizeFromText(String value) {
  final parsed = double.tryParse(value.trim());

  if (parsed == null || parsed < 1 || parsed > 200) {
    _fontSizeController.text = _fontSize.toStringAsFixed(
      _fontSize.truncateToDouble() == _fontSize ? 0 : 1,
    );
    return;
  }

  setState(() {
    _fontSize = parsed;
    _fontSizeController.text = parsed.toStringAsFixed(
      parsed.truncateToDouble() == parsed ? 0 : 1,
    );
    _fontSizeController.selection = TextSelection.collapsed(
      offset: _fontSizeController.text.length,
    );
  });
}

void _toggleStrikethrough() {
  setState(() {
    _isStrikethrough = !_isStrikethrough;
  });
}

void _toggleSuperscript() {
  setState(() {
    _isSuperscript = !_isSuperscript;
    if (_isSuperscript) {
      _isSubscript = false;
    }
  });
}

void _toggleSubscript() {
  setState(() {
    _isSubscript = !_isSubscript;
    if (_isSubscript) {
      _isSuperscript = false;
    }
  });
}

void _increaseFontSize() {
  setState(() {
    _fontSize = (_fontSize + 1).clamp(1, 200).toDouble();
    _fontSizeController.text =
        _fontSize.truncateToDouble() == _fontSize
            ? _fontSize.toInt().toString()
            : _fontSize.toString();
  });
}

void _decreaseFontSize() {
  setState(() {
    _fontSize = (_fontSize - 1).clamp(1, 200).toDouble();
    _fontSizeController.text =
        _fontSize.truncateToDouble() == _fontSize
            ? _fontSize.toInt().toString()
            : _fontSize.toString();
  });
}

void _showColorPicker({required bool highlight}) {
  final colors = <Color>[
    Colors.black,
    Colors.red,
    Colors.blue,
    Colors.green,
    Colors.orange,
    Colors.purple,
    Colors.brown,
    Colors.grey,
    Colors.yellow,
    Colors.pink,
    Colors.cyan,
    Colors.white,
    Colors.transparent,
  ];

  showDialog(
    context: context,
    builder: (dialogContext) {
      return AlertDialog(
        title: Text(
          highlight ? 'Text Highlight' : 'Font Color',
        ),
        content: Wrap(
          spacing: 8,
          runSpacing: 8,
          children: colors.map((color) {
            return InkWell(
              onTap: () {
                setState(() {
                  if (highlight) {
                    _highlightColor = color;
                  } else {
                    _fontColor = color;
                  }
                });
                Navigator.pop(dialogContext);
              },
              child: Container(
                width: 34,
                height: 34,
                decoration: BoxDecoration(
                  color: color == Colors.transparent
                      ? Colors.white
                      : color,
                  border: Border.all(
                    color: Colors.grey,
                  ),
                ),
                child: color == Colors.transparent
                    ? const Icon(
                        Icons.block,
                        size: 18,
                      )
                    : null,
              ),
            );
          }).toList(),
        ),
      );
    },
  );
}

void _showTextEffects() {
  showModalBottomSheet(
    context: context,
    builder: (sheetContext) {
      return SafeArea(
        child: Wrap(
          children: [
            const ListTile(
              title: Text(
                'Text Effects',
                style: TextStyle(
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            ListTile(
              leading: const Icon(
                Icons.auto_awesome,
              ),
              title: const Text('Shadow'),
              onTap: () {
                Navigator.pop(sheetContext);
                _showMessage('Text Shadow selected.');
              },
            ),
            ListTile(
              leading: const Icon(
                Icons.format_clear,
              ),
              title: const Text('No Effect'),
              onTap: () {
                Navigator.pop(sheetContext);
                _showMessage('Text effects cleared.');
              },
            ),
          ],
        ),
      );
    },
  );
}

void _clearFormatting() {
  setState(() {
    _isBold = false;
    _isItalic = false;
    _isUnderline = false;
    _isStrikethrough = false;
    _isSuperscript = false;
    _isSubscript = false;

    _fontColor = Colors.black;
    _highlightColor = Colors.transparent;

    _fontName = 'Calibri';
    _fontSize = 11;

    _fontNameController.text = 'Calibri';
    _fontSizeController.text = '11';
  });

  _showMessage('Formatting cleared.');
}

