  Widget _buildEditor() {
    double pageWidth;
    double pageHeight;

    switch (_pageSizeName) {
      case 'A5':
        pageWidth = 559;
        pageHeight = 794;
        break;
      case 'Letter':
        pageWidth = 612;
        pageHeight = 792;
        break;
      case 'Legal':
        pageWidth = 612;
        pageHeight = 1008;
        break;
      case 'A4':
      default:
        pageWidth = 595;
        pageHeight = 842;
    }

    if (_landscape) {
      final temp = pageWidth;
      pageWidth = pageHeight;
      pageHeight = temp;
    }

    final horizontalMargin = _marginLeft + _marginRight;
    final verticalMargin = _marginTop + _marginBottom;

    final usableWidth = (pageWidth - horizontalMargin).clamp(120.0, 2000.0);
    final usableHeight = (pageHeight - verticalMargin).clamp(200.0, 3000.0);

    final textLength = _controller.text.length;
    final charsPerPage = math.max(
      1,
      (usableWidth / (_fontSize * 0.55)).floor(),
    );
    final linesPerPage = math.max(
      1,
      (usableHeight / (_fontSize * 1.35)).floor(),
    );
    final estimatedLines = math.max(1, (textLength / charsPerPage).ceil());
    final estimatedPages = math.max(1, (estimatedLines / linesPerPage).ceil());

    return Container(
      color: const Color(0xFFD9D9D9),
      child: LayoutBuilder(
        builder: (context, constraints) {
          return SingleChildScrollView(
            keyboardDismissBehavior: ScrollViewKeyboardDismissBehavior.manual,
            padding: const EdgeInsets.symmetric(vertical: 24, horizontal: 12),
            child: Center(
              child: Container(
                width: pageWidth,
                constraints: BoxConstraints(minHeight: pageHeight),
                decoration: BoxDecoration(
                  color: _pageColor,
                  border: _pageBorderStyle == 'None'
                      ? null
                      : Border.all(
                          color: Colors.black54,
                          width: _pageBorderStyle == '3-D' ? 3 : 1,
                        ),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withValues(alpha: .18),
                      blurRadius: 8,
                      offset: const Offset(0, 3),
                    ),
                  ],
                ),
                child: Stack(
                  children: [
                    if (_watermark.trim().isNotEmpty)
                      Positioned.fill(
                        child: IgnorePointer(
                          child: Center(
                            child: Transform.rotate(
                              angle: -0.55,
                              child: Opacity(
                                opacity: .10,
                                child: Text(
                                  _watermark,
                                  textAlign: TextAlign.center,
                                  style: TextStyle(
                                    fontSize: 42,
                                    fontWeight: FontWeight.bold,
                                    color: Colors.black,
                                  ),
                                ),
                              ),
                            ),
                          ),
                        ),
                      ),

                    Padding(
                      padding: EdgeInsets.fromLTRB(
                        _marginLeft,
                        _marginTop,
                        _marginRight,
                        _marginBottom,
                      ),
                      child: _columns <= 1
                          ? TextField(
                              controller: _controller,
                              maxLines: null,
                              minLines: 1,
                              keyboardType: TextInputType.multiline,
                              textAlignVertical: TextAlignVertical.top,
                              scrollPadding: const EdgeInsets.only(
                                bottom: 320,
                                top: 80,
                              ),
                              style: TextStyle(
                                fontFamily: _fontName,
                                fontSize: _fontSize,
                                fontWeight: _isBold
                                    ? FontWeight.bold
                                    : FontWeight.normal,
                                fontStyle: _isItalic
                                    ? FontStyle.italic
                                    : FontStyle.normal,
                                decoration: _isUnderline
                                    ? TextDecoration.underline
                                    : TextDecoration.none,
                                height: _lineSpacing > 0 ? _lineSpacing : 1.35,
                              ),
                              decoration: const InputDecoration(
                                border: InputBorder.none,
                                isCollapsed: true,
                                contentPadding: EdgeInsets.zero,
                              ),
                              onChanged: (_) {
                                setState(() {});
                              },
                            )
                          : Row(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: List.generate(
                                _columns,
                                (index) => Expanded(
                                  child: Padding(
                                    padding: EdgeInsets.only(
                                      right: index == _columns - 1 ? 0 : 12,
                                    ),
                                    child: index == 0
                                        ? TextField(
                                            controller: _controller,
                                            maxLines: null,
                                            keyboardType:
                                                TextInputType.multiline,
                                            textAlignVertical:
                                                TextAlignVertical.top,
                                            scrollPadding:
                                                const EdgeInsets.only(
                                                  bottom: 320,
                                                  top: 80,
                                                ),
                                            style: TextStyle(
                                              fontFamily: _fontName,
                                              fontSize: _fontSize,
                                              fontWeight: _isBold
                                                  ? FontWeight.bold
                                                  : FontWeight.normal,
                                              fontStyle: _isItalic
                                                  ? FontStyle.italic
                                                  : FontStyle.normal,
                                              decoration: _isUnderline
                                                  ? TextDecoration.underline
                                                  : TextDecoration.none,
                                              height: _lineSpacing > 0
                                                  ? _lineSpacing
                                                  : 1.35,
                                            ),
                                            decoration: const InputDecoration(
                                              border: InputBorder.none,
                                              isCollapsed: true,
                                              contentPadding: EdgeInsets.zero,
                                            ),
                                            onChanged: (_) {
                                              setState(() {});
                                            },
                                          )
                                        : const SizedBox.shrink(),
                                  ),
                                ),
                              ),
                            ),
                    ),
                  ],
                ),
              ),
            ),
          );
        },
      ),
    );
