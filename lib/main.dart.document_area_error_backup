  void _performFind(String query) {
    final value = query.trim();

    if (value.isEmpty) {
      _showMessage('Enter text to find.');
      return;
    }

    final source = _controller.text;
    final index = source.toLowerCase().indexOf(value.toLowerCase());

    if (index == -1) {
      _showMessage('Text not found: $value');
      return;
    }

    _controller.selection = TextSelection(
      baseOffset: index,
      extentOffset: index + value.length,
    );

    _showMessage('Found: $value');
  }

