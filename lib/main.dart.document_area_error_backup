        offset: _fontNameController.text.length,
      );
    });
  }

  void _setFontSizeFromText(String value) {
    final parsed = double.tryParse(value.trim());

    if (parsed == null || parsed < 1 || parsed > 200) {
      _fontSizeController.text = _fontSize.toStringAsFixed(
        _fontSize.truncateToDouble() == _fontSize ? 0 : 1,
      );
      return;
    }

    setState(() {
      _fontSize = parsed;
      _fontSizeController.text = parsed.toStringAsFixed(
        parsed.truncateToDouble() == parsed ? 0 : 1,
      );
      _fontSizeController.selection = TextSelection.collapsed(
        offset: _fontSizeController.text.length,
      );
    });
  }

