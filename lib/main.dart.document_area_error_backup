  void _replaceNext(String find, String replace) {
    final value = find.trim();

    if (value.isEmpty) {
      _showMessage('Enter text to find.');
      return;
    }

    final source = _controller.text;
    final index = source.toLowerCase().indexOf(value.toLowerCase());

    if (index == -1) {
      _showMessage('Text not found: $value');
      return;
    }

    final newText = source.replaceRange(index, index + value.length, replace);

    _controller.value = TextEditingValue(
      text: newText,
      selection: TextSelection.collapsed(offset: index + replace.length),
    );

    _showMessage('Replaced 1 occurrence.');
  }

  void _replaceAll(String find, String replace) {
    final value = find.trim();

    if (value.isEmpty) {
      _showMessage('Enter text to find.');
      return;
    }

    final source = _controller.text;
    final lowerSource = source.toLowerCase();
    final lowerFind = value.toLowerCase();

    var count = 0;
    var position = 0;

    while (true) {
      final index = lowerSource.indexOf(lowerFind, position);

      if (index == -1) {
        break;
      }

      count++;
      position = index + value.length;
    }

    if (count == 0) {
      _showMessage('Text not found: $value');
      return;
    }

    var result = source;
    var offset = 0;

    while (true) {
      final lowerResult = result.toLowerCase();
      final index = lowerResult.indexOf(lowerFind, offset);

      if (index == -1) {
        break;
      }

      result = result.replaceRange(index, index + value.length, replace);

      offset = index + replace.length;
    }

    _controller.value = TextEditingValue(
      text: result,
      selection: TextSelection.collapsed(offset: result.length),
    );

    _showMessage('Replaced $count occurrence(s).');
  }

  void _insertText(String value) {
    final selection = _controller.selection;

    final start = selection.isValid ? selection.start : _controller.text.length;
    final end = selection.isValid ? selection.end : start;

