  void _updateWordCount() {
    final text = _controller.text.trim();

    final count = text.isEmpty
        ? 0
        : text.split(RegExp(r'\s+')).where((e) => e.isNotEmpty).length;

    if (mounted) {
      setState(() {
        _wordCount = count;
      });
    }
  }

