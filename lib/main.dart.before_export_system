      'Cambria',
      'Georgia',
      'Verdana',
      'Tahoma',
      'Courier New',
      'Roboto',
      'Noto Sans',
      'Noto Serif',
    ];

    final sizes = <double>[
      8,
      9,
      10,
      11,
      12,
      14,
      16,
      18,
      20,
      24,
      28,
