  Widget _buildEditor() {
    double pageWidth;
    double pageHeight;

    switch (_pageSizeName) {
      case 'A5':
        pageWidth = 559;
        pageHeight = 794;
        break;
      case 'Letter':
        pageWidth = 612;
        pageHeight = 792;
        break;
      case 'Legal':
        pageWidth = 612;
        pageHeight = 1008;
        break;
      case 'A4':
      default:
        pageWidth = 595;
        pageHeight = 842;
    }

    if (_landscape) {
      final temp = pageWidth;
      pageWidth = pageHeight;
      pageHeight = temp;
    }

    final contentWidth = (pageWidth - _marginLeft - _marginRight)
        .clamp(260.0, pageWidth)
        .toDouble();

    final contentHeight = (pageHeight - _marginTop - _marginBottom)
        .clamp(400.0, pageHeight)
        .toDouble();

    Border? pageBorder;

    switch (_pageBorderStyle) {
      case 'Box':
        pageBorder = Border.all(color: Colors.grey, width: 1.2);
        break;
      case 'Shadow':
        pageBorder = Border.all(color: Colors.grey, width: 1);
        break;
      case '3-D':
        pageBorder = Border.all(color: Colors.black54, width: 2);
        break;
      default:
        pageBorder = null;
    }

    return Container(
      color: const Color(0xFFD9D9D9),
      child: Center(
        child: SingleChildScrollView(
          padding: const EdgeInsets.symmetric(vertical: 24, horizontal: 12),
          child: Container(
            width: pageWidth,
            constraints: BoxConstraints(minHeight: pageHeight),
            decoration: BoxDecoration(
              color: _pageColor,
              border: pageBorder,
              boxShadow: [
                BoxShadow(
                  color: Colors.black.withValues(alpha: .18),
                  blurRadius: 8,
                  offset: const Offset(0, 3),
                ),
              ],
            ),
            child: Stack(
              children: [
                Padding(
                  padding: EdgeInsets.fromLTRB(
                    _marginLeft,
                    _marginTop,
                    _marginRight,
                    _marginBottom,
                  ),
                  child: SizedBox(
                    width: contentWidth,
                    height: contentHeight,
                    child: TextField(
                      controller: _controller,
                      maxLines: null,
                      expands: false,
                      keyboardType: TextInputType.multiline,
                      textAlign: TextAlign.left,
                      textAlignVertical: TextAlignVertical.top,
                      style: TextStyle(
                        fontFamily: _fontSetName == 'Office'
                            ? _fontName
                            : _fontSetName == 'Classic'
                            ? 'Times New Roman'
                            : _fontSetName == 'Modern'
                            ? 'Arial'
                            : _fontSetName == 'Simple'
                            ? 'Roboto'
                            : _fontName,
                        fontSize: _fontSize,
                        fontWeight: _isBold
                            ? FontWeight.bold
                            : FontWeight.normal,
                        fontStyle: _isItalic
                            ? FontStyle.italic
                            : FontStyle.normal,
                        decoration: _isUnderline
                            ? TextDecoration.underline
                            : TextDecoration.none,
                        height: _lineSpacing,
                      ),
                      decoration: const InputDecoration(
                        border: InputBorder.none,
                        isCollapsed: true,
                      ),
                    ),
                  ),
                ),
                if (_watermark.isNotEmpty)
                  Positioned.fill(
                    child: IgnorePointer(
                      child: Center(
                        child: Transform.rotate(
                          angle: -0.55,
                          child: Text(
                            _watermark,
                            style: TextStyle(
                              fontSize: 42,
                              fontWeight: FontWeight.bold,
                              color: Colors.grey.withValues(alpha: .20),
                            ),
                          ),
                        ),
                      ),
                    ),
                  ),
              ],
            ),
          ),
        ),
      ),
    );
  }

